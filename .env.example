# === NutriX — variáveis para rodar FORA do Manus ===
# Copie para .env e preencha. NUNCA suba .env para o GitHub.

APP_URL=http://localhost:3000
NODE_ENV=development

# --- Banco de dados (o mesmo TiDB/MySQL de hoje) ---
# IMPORTANTE: troque a senha do banco no painel do TiDB antes de reutilizar,
# porque a senha antiga veio exposta no export do Manus.
DATABASE_URL=mysql://USUARIO:SENHA@HOST:4000/BANCO?ssl={"rejectUnauthorized":true}

# --- Autenticação própria (substitui o OAuth do Manus) ---
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Login com Google (Google Cloud Console > Credenciais > OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Pagamento (Stripe) — habilita cartão + Pix ---
STRIPE_SECRET_KEY=sk_live_ou_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_ou_test_...

# --- Entrega da dieta ---
# E-mail (Resend): https://resend.com
RESEND_API_KEY=re_...
EMAIL_FROM=NutriX <dieta@seudominio.com.br>
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
